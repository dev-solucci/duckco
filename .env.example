# Supabase (Lucky Cards backend). Copy to .env.local and fill with your project
# values from the Supabase dashboard: Project Settings > API.
# The anon key is safe to expose in the browser; never put the service role key
# in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shopify (commerce, headless). Fill when the store exists.
# See docs/commerce-shopify.md.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
